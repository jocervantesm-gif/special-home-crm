# php -- BEGIN cPanel-generated handler, do not edit
# Configure el paquete “ea-php84” como el lenguaje de programación predeterminado “PHP”.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

Options -MultiViews
Options +FollowSymLinks
RewriteEngine On

# Desactivar explícitamente el manejador de texto plano para archivos py
RemoveHandler .py
RemoveType .py

# Configurar Passenger de forma directa por Apache
<IfModule mod_passenger.c>
  PassengerAppRoot /home4/irvingsa/specialhome.com.mx
  PassengerStartupFile passenger_wsgi.py
  PassengerPython /usr/bin/python3
</IfModule>

# Enrutar todo el tráfico hacia el script de Python mediante WSGI de Passenger
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ passenger_wsgi.py [QSA,L]